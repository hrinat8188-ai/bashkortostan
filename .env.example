NEXT_PUBLIC_SUPABASE_ANON_KEY=ТВОЙ_ANON_КЛЮЧ
SUPABASE_SERVICE_ROLE_KEY=ТВОЙ_SERVICE_ROLE_КЛЮЧ

# Telegram Bot (берёшь у @BotFather)
TELEGRAM_BOT_TOKEN=1234567890:AAF_ТВОЙ_ТОКЕН
NEXT_PUBLIC_TELEGRAM_BOT_NAME=bashkortostan_learn_bot

# Anthropic Claude AI (берёшь на console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-ТВОЙ_КЛЮЧ

# URL приложения (после деплоя на Vercel замени на реальный)
